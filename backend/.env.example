# Copie este arquivo para .env e preencha os valores reais.
# NUNCA suba o arquivo .env para o repositorio.

# Chave da API do OpenRouter.
# Em producao este valor vai para o Secret Manager, nao para o frontend:
# npx firebase-tools functions:secrets:set OPENROUTER_API_KEY
OPENROUTER_API_KEY=sua_chave_aqui

# Modelo a ser utilizado (pode trocar por outro disponivel no OpenRouter)
OPENROUTER_MODEL=nvidia/nemotron-3-super-120b-a12b:free

# Modelo exclusivo dos tutores. Se ficar vazio, usa OPENROUTER_MODEL.
# A chave OPENROUTER_API_KEY continua somente no backend.
TUTOR_MODEL=

# Maximo de mensagens de tutor por usuario por dia UTC.
TUTOR_DAILY_LIMIT=40

# Caminho para o arquivo JSON de credenciais do Firebase (Service Account).
# Em producao (Cloud Functions) deixe vazio: o Admin SDK usa as credenciais do projeto.
FB_CREDENTIALS_PATH=./firebase_credentials.json

# ID do projeto Firebase novo. Nao use o projeto antigo.
FIREBASE_PROJECT_ID=

# Origens extras de CORS, separadas por virgula.
# Localhost ja e permitido. No Hosting, frontend e /api ficam no mesmo dominio
# e nao precisam de origem extra. Preencha so se o frontend chamar a API de outro dominio.
CORS_ORIGINS=

# URL publica do app, usada como HTTP-Referer do OpenRouter.
# Exemplo: https://pygamesapcprojeto.web.app
APP_PUBLIC_URL=

# Configuracoes da API
API_HOST=0.0.0.0
API_PORT=8000

# BeeCrowd e apenas a fonte de Exercicios Prontos.
# Credencial da aplicacao, fornecida pelo BeeCrowd. Nunca vai para o frontend.
BEECROWD_API_BASE_URL=https://api.beecrowd.com.br
BEECROWD_API_EMAIL=
BEECROWD_API_PASSWORD=
BEECROWD_CACHE_TTL=86400
