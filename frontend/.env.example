# URL base da API FastAPI (sem barra no final)
VITE_API_URL=http://localhost:8000

# Chaves de Configuracao do Firebase (Console -> Configurar App Web)
VITE_FIREBASE_API_KEY=your-firebase-api-key
VITE_FIREBASE_AUTH_DOMAIN=pygame-apc.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=pygame-apc
VITE_FIREBASE_STORAGE_BUCKET=pygame-apc.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your-sender-id
VITE_FIREBASE_APP_ID=your-app-id
