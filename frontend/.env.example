# Copie este arquivo para .env.local e preencha com os valores reais.
# Reinicie o servidor (npm run dev) apos alterar variaveis de ambiente.
# NUNCA commite o arquivo .env.local.

# URL base da API FastAPI (sem barra no final)
VITE_API_URL=http://localhost:8000

# Chaves do Firebase (Console Firebase > Configuracoes do projeto > Seus apps > SDK)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=pygames-apc.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=pygames-apc
VITE_FIREBASE_STORAGE_BUCKET=pygames-apc.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
